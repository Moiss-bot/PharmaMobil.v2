
CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    estado INTEGER NOT NULL DEFAULT 1,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT *
FROM producto
ORDER BY nombre ASC;

pendientesPorEnviar:
SELECT *
FROM producto
WHERE pendiente = 1
AND intentos < :maxIntentos
ORDER BY id ASC;

contarPendientes:
SELECT COUNT(*)
FROM producto
WHERE pendiente = 1
AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*)
FROM producto
WHERE pendiente = 1
AND intentos >= :maxIntentos;

insertar:
INSERT OR REPLACE INTO producto
(id, nombre, precio, stock, estado, pendiente, intentos, ultimoError)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

actualizar:
UPDATE producto
SET nombre = :nombre,
    precio = :precio,
    stock = :stock,
    estado = :estado,
    pendiente = 1,
    intentos = 0,
    ultimoError = NULL
WHERE id = :id;

desactivarProducto:
UPDATE producto
SET estado = 0,
    pendiente = 1,
    intentos = 0,
    ultimoError = NULL
WHERE id = :id;

activarProducto:
UPDATE producto
SET estado = 1,
    pendiente = 1,
    intentos = 0,
    ultimoError = NULL
WHERE id = :id;

sumarIntento:
UPDATE producto
SET intentos = intentos + 1,
    ultimoError = :motivo
WHERE id = :id;

marcarFallida:
UPDATE producto
SET intentos = 99,
    ultimoError = :motivo
WHERE id = :id;

eliminarPorId:
DELETE FROM producto
WHERE id = :id;

borrarSincronizados:
DELETE FROM producto
WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0)
FROM producto;

confirmarSincronizacion:
UPDATE producto
SET id = :idServidor,
    pendiente = 0,
    intentos = 0,
    ultimoError = NULL
WHERE id = :idLocal;
