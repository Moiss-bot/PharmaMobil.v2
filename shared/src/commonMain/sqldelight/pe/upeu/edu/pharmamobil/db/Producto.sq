CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

pendientesPorEnviar:
SELECT * FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos ORDER BY id ASC;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= :maxIntentos;

insertar:
INSERT OR REPLACE INTO producto
VALUES (?, ?, ?, ?, ?, ?, ?);

actualizar:
UPDATE producto
SET nombre = :nombre, precio = :precio, stock = :stock, pendiente = 1
WHERE id = :id;

sumarIntento:
UPDATE producto
SET intentos = intentos + 1, ultimoError = :motivo
WHERE id = :id;

marcarFallida:
UPDATE producto
SET intentos = 99, ultimoError = :motivo
WHERE id = :id;

eliminarPorId:
DELETE FROM producto WHERE id = :id;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;